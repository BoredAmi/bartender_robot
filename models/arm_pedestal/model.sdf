<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="arm_pedestal">
    <!-- What arm B stands on. Origin at floor level, centred, so the model
         pose is (x, y, 0) and the top face lands at 0.9 - the same height as
         the counter top, which is what arm A is bolted to. Both arms then
         work from the same datum and a z in one arm's base frame means the
         same thing in the other's.

         Purely scenery as far as the physics goes: the arm is spawned as one
         model whose world link is placed by ros_gz create, so it is held up
         by that, not by this. What this is really for is (a) not having a
         robot visibly floating in mid-air and (b) being a solid thing in the
         planning scene, since a plan that sweeps arm A through the volume
         arm B is standing in would be a plan through a pedestal. -->
    <static>true</static>
    <link name="pedestal_link">
      <visual name="pedestal_visual">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry><box><size>0.30 0.30 0.90</size></box></geometry>
        <material>
          <ambient>0.08 0.08 0.09 1</ambient>
          <diffuse>0.18 0.18 0.20 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name="pedestal_collision">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry><box><size>0.30 0.30 0.90</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
    </link>
  </model>
</sdf>
