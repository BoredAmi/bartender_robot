<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="jack_daniels_bottle">
    <!-- Link origin sits at the center of the bottle's base, so placing the
         model's pose z at table height puts the bottle exactly on the surface. -->
    <link name="bottle_link">
      <inertial>
        <pose>0 0 0.1225 0 0 0</pose>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.005375</ixx>
          <iyy>0.005375</iyy>
          <izz>0.000745</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="bottle_visual">
        <!-- source mesh is Y-up (Blender OBJ export); rotate +90 deg about X
             so the bottle's height axis becomes Z-up as SDF expects. -->
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/bottle.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.05 0.02 0.01 1</ambient>
          <diffuse>0.25 0.09 0.03 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>

      <!-- Cheap cylinder collision instead of the 34k-face visual mesh, for
           stable, fast grasp physics. -->
      <collision name="bottle_collision">
        <pose>0 0 0.1225 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0386</radius>
            <length>0.245</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>0.9</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
